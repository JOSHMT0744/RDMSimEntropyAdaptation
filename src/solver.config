############ DIRECTORIES ############
# name of the directory to which output is written
outputDirectory=output_dir

# name of the directory in which .POMDP files can be found
domainDirectory=domains


############ GENERAL SETTINGS ############
# the type of algorithm that should be used: gip, perseus
#   gip refers to generalized incremental pruning (exact)
#   perseus is a randomized point-based value iteration algorithm (approximate)
algorithmType=erperseus

# Entropy regularisation parameter (temperature in softmax(Q_a / lambda)).
#   lambda=0.0  -> hard max; ERPerseus reduces to plain Perseus. THIS IS THE CONTROL ARM.
#   lambda>0    -> entropy-regularised action mixing.
#
# lambda is NOT scale-free: it only matters relative to the gap between the per-action
# Q-values, which the run logs to output_dir/qvalues.txt (columns:
# timestep, Q_MST, Q_RT, |gap|). Measured on this domain (rewards 1-43, discount 0.9,
# scenario 3): mean |Q_MST - Q_RT| ~ 6.7. Since P(better action) = 1/(1+exp(-gap/lambda)),
# the operative range sits an order of magnitude above 1:
#
#   lambda   P(better)   measured RT share over 80 steps
#   0.0      1.000       10%   (hard max)
#   1.0      0.999        1%   (indistinguishable from hard max)
#   2.0      0.966       19%
#   5.0      0.791       29%
#   10.0     0.661       48%
#   20.0     0.583       56%
#
# So lambda in (0,1] is effectively still hard-max HERE; useful mixing starts around
# lambda=2 and washes out toward uniform past ~20. Suggested sweep: {0.0, 2, 5, 10, 20},
# with lambda=0.0 as the Perseus control. Re-check qvalues.txt if the reward table,
# discount or scenario changes -- the gap, and so the useful range, moves with them.
lambda=0.0

############ EXPERIMENT PARAMETERS (optional) ############
# runSeed: base random seed for the solver, the action-selection policy and the
# per-timestep deviation draw (default 222). Vary for repeated runs (e.g. 222,223,224).
runSeed=222
# surpriseMeasureForGamma: CC (Confidence-Corrected), BF (Bayes Factor), or MIP (Mutual Information Surprise). Default MIP.
surpriseMeasureForGamma=MIP
# p_c: probability of change in (0,1) for SMiLe gamma; m = p_c/(1-p_c). Default 0.5.
p_c=0.5
# useSurpriseUpdating: true = SMiLe (surprise-weighted) updates; false = classic Bayesian (Dirichlet +1 only). Default true.
useSurpriseUpdating=true
# lookback: lookback period (m) for MIP calculation. Number of timesteps to look back when computing MIP = MI[current] - MI[current - lookback]. Default 4.
lookback=4

# priorStrength: strength of the informative Dirichlet prior seeded from the .POMDP
# transition/observation functions. alpha = priorStrength * P * n, so 1.0 carries the
# same total pseudo-count mass as a flat alpha=1 prior while keeping the prior's shape.
# Larger values make the learned model slower to move away from the prior.
priorStrength=1.0

############ NFR THRESHOLDS ############
# NFR thresholds are NOT set here. They are defined in config_log_files/configuration.json
# as percentages of network capacity (link_threshold / bandwidth_threshold /
# writing_times_threshold) and converted to absolute values by RDMSim's
# NetworkProperties.loadNetworkSettings(). Edit that file to vary them.
#
# For 25 mirrors (number_of_links = 25*24/2 = 300):
#   MON1 = active links (reliability, MR):        35% of 300      ->  105 links, satisfied when active_links >= 105
#   MON2 = bandwidth consumption (cost, MC):      40% of 300*30   -> 3600 Gbps,  satisfied when bandwidth_consumption <= 3600
#   MON3 = time to write (performance, MP):       45% of 300*20   -> 2700 ms,    satisfied when time_to_write <= 2700

# the algorithm terminates if the absolute value difference in two successive iterations is below the tolerance
valueFunctionTolerance=0.000001

# the algorithm terminates if the running time exceeds the limit (after completion of a stage)
timeLimit=1000


############ EXACT ALGORITHM SETTINGS ############
# The exact (GIP) solver path has been removed. lpsolver, pruningMethod,
# acceleratedLPThreshold, acceleratedTolerance and coefficientThreshold are no longer
# read by any code and have been deleted from this file.

# vectors are only added if the value improvement exceeds epsilon
epsilon=0.000001


############ APPROXIMATE ALGORITHM SETTINGS ############
# the settings below define how many runs the belief sampling executes, and how many steps
beliefSamplingRuns=10
beliefSamplingSteps=200
#beliefSamplingRuns=200
#beliefSamplingSteps=100


############ OUTPUT FILES ############
# this property can be used to dump a policy graph after convergence (only when using the exact method)
dumpPolicyGraph=false

# this property can be used to ensure that actions in the output files are labels rather than numbers
dumpActionLabels=true

